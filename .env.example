# grouplink env contract, grouped by the package that owns each variable.
# Copy to .env for local runs. Everything below is read lazily, at first use.
#
# A local dry run needs only NOTION_TOKEN, NOTION_LINKS_DATABASE_ID,
# NOTION_PROFILES_DATABASE_ID, SITE_DEFAULT_SLUG, and REDIS_URL. For REDIS_URL,
# run `docker run -p 6379:6379 redis` and use redis://localhost:6379. The preview
# scripts refuse any Redis that is not on this machine.

# --- render-lab-tasks-notion ---
# Internal integration token, shared with the links database.
NOTION_TOKEN=
NOTION_LINKS_DATABASE_ID=
# Name, Slug, Tagline. The links database relates to it through a Profiles column.
NOTION_PROFILES_DATABASE_ID=

# --- render-lab-tasks-render-kv ---
# Internal connection string of the grouplink-cache Key Value instance. The
# Workflow and the web service both use it.
REDIS_URL=

# --- grouplink config ---
# Set to true to read and enrich without writing the site snapshot.
DRY_RUN=false
SITE_URL=
# Slug of the profile the root page shows.
SITE_DEFAULT_SLUG=
# METADATA_TTL_SECONDS=604800
# LINKS_LIMIT=100

# --- web service: pages and the webhook receiver ---
# Used to start Workflow runs.
RENDER_API_KEY=
WORKFLOW_SLUG=
REBUILD_TASK=grouplink.rebuild
# Verification token from the Notion webhook subscription. Leave it unset for the
# first deploy so the verification handshake is accepted, then set it.
NOTION_WEBHOOK_SECRET=
# Bearer token required on POST /tasks/:task.
DISPATCH_TOKEN=
# Quiet period before an edit starts a run.
# DEBOUNCE_MS=60000
