# grouplink env contract, grouped by the package that owns each variable.
# Copy to .env for local runs. Everything below is read lazily, at first use.
#
# A local dry run needs only NOTION_TOKEN, NOTION_LINKS_DATABASE_ID,
# NOTION_PEOPLE_DATABASE_ID, SITE_DEFAULT_SLUG, and REDIS_URL. The GitHub and
# Render values are read when DRY_RUN is false. For REDIS_URL, either run
# `docker run -p 6379:6379 redis` and use redis://localhost:6379, or use the
# external connection string of a Render Key Value instance.

# --- render-lab-tasks-notion ---
# Internal integration token, shared with the links database.
NOTION_TOKEN=
NOTION_LINKS_DATABASE_ID=
# Name, Slug, Tagline. The links database relates to it through a People column.
NOTION_PEOPLE_DATABASE_ID=

# --- render-lab-tasks-render-kv ---
# Internal connection string of the grouplink-cache Key Value instance.
REDIS_URL=

# --- render-lab-tasks-github ---
# Fine-grained PAT, classic PAT, or GitHub App installation token. Needs
# Contents: Read and write on the site repo. See the README.
GITHUB_TOKEN=
# Owner and name of the repo the pages are committed to.
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BRANCH=main

# --- render-lab-tasks-render ---
RENDER_API_KEY=
RENDER_STATIC_SITE_ID=

# --- render-lab-tasks-slack (optional) ---
# Unset means the run digest goes to the console instead.
# SLACK_WEBHOOK_URL=

# --- grouplink config ---
# Set to true to read and render without committing or deploying.
DRY_RUN=false
SITE_URL=
# Slug of the person the root page shows. Their page is written to both
# site/index.html and site/<slug>/index.html.
SITE_DEFAULT_SLUG=
# SITE_DIR=site
# METADATA_TTL_SECONDS=86400
# LINKS_LIMIT=100

# --- trigger layer: the webhook receiver ---
WORKFLOW_SLUG=
REBUILD_TASK=grouplink.rebuild
# Verification token from the Notion webhook subscription. Leave it unset for the
# first deploy so the verification handshake is accepted, then set it.
NOTION_WEBHOOK_SECRET=
# Bearer token required on POST /tasks/:task.
DISPATCH_TOKEN=
# Quiet period before an edit starts a run.
# DEBOUNCE_MS=60000
